# Copy to .env and adjust. The backend reads ../.env and backend/.env;
# docker compose passes this file to the app container.

# development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# JSON list of origins allowed to call the API cross-origin
CORS_ORIGINS=["http://localhost:5173"]

# --- Receipt analysis -------------------------------------------------------
# openrouter (default) | openai | mock (no API key, a fixed sample receipt) |
# local (ollama on the host, images only — no PDF support with `local`)
AI_PROVIDER=mock
# Any OpenRouter model id that reads images, e.g. anthropic/claude-haiku-4.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local OCR provider (AI_PROVIDER=local): ollama's /v1 endpoint and the
# vision model to use, e.g. `ollama pull richardyoung/lightonocr-3-4b:Q4_K_M`
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=richardyoung/lightonocr-3-4b:Q4_K_M
# Account for analysed receipts that no payee rule matches (optional)
# DEFAULT_SOURCE_ACCOUNT=Assets:Checking
# Payee rules: copy backend/config/payee-account-rules.example.json to
# backend/config/payee-account-rules.json and edit it.
# Expense account for receipt items no classification rule matches
# DEFAULT_UNALLOCATED_ACCOUNT=expenses:unallocated
# Source-account roles (personal cards vs shared card) for ledger/CSV routing:
# copy backend/config/account-roles.example.json to
# backend/config/account-roles.json and edit it.
# ACCOUNT_ROLES_PATH=./config/account-roles.json

# --- Ledger -----------------------------------------------------------------
# beancount (default) | hledger (journal file + hledger CLI, no service)
LEDGER_PROVIDER=beancount
# `make dev-ledger` runs the beancount service here
BEANCOUNT_SERVICE_URL=http://localhost:8100
# hledger backend (LEDGER_PROVIDER=hledger): the journal the app reads and
# validates against (no default — required in this mode), the file entries
# are appended to (defaults to HLEDGER_FILE), the binary and per-command
# timeout. Host setup: reads from the main journal, appends to the app-owned
# receipts journal that the main journal includes.
# HLEDGER_FILE=~/.ledger/current.journal
# HLEDGER_APPEND_FILE=~/.ledger/receipts.journal
# HLEDGER_BINARY=hledger
# HLEDGER_TIMEOUT_SECONDS=10

# --- Storage ----------------------------------------------------------------
# Defaults suit development; the Docker image sets its own paths.
# DATABASE_URL=sqlite:///./data/receipts.db
# UPLOADS_DIR=./uploads
# Delete the oldest uploaded documents beyond this size, e.g. 1GB (optional)
# MAX_UPLOADS_DISK_SIZE=1GB
# CLEANUP_INTERVAL_HOURS=24

# Frontend: leave unset for same-origin /api (the default in dev and prod)
# VITE_API_URL=
